#!/usr/bin/env python
# vim:fileencoding=utf-8
import json
import time
from calibre.web.feeds.news import BasicNewsRecipe


class FinanceKnowledge(BasicNewsRecipe):
    title = '财经知识'
    description = '每日财经快讯'
    language = 'zh'
    no_stylesheets = True
    remove_javascript = True
    max_articles_per_feed = 100
    oldest_article = 7
    timefmt = '[%Y年 %m月 %d日 星期%a]'
    feeds = []  # 由 parse_index 接管

    # 金十快讯 API（RSSHub 源码中使用的公开端点）
    API_URL = 'https://flash-api.jin10.com/get_flash_list'

    def get_browser(self):
        br = BasicNewsRecipe.get_browser(self)
        br.addheaders = [
            ('x-app-id', 'g93rhHb9DcDptyPb'),
            ('x-version', '1.0.1'),
            ('User-Agent',
             'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 '
             '(KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36'),
        ]
        return br

    def parse_index(self):
        try:
            resp = self.browser.open(self.API_URL, timeout=30)
            raw = resp.read()
            payload = json.loads(raw)
        except Exception as e:
            self.abort_recipe_processing(f'请求金十快讯 API 失败：{e}')

        items = payload.get('data', [])
        if not items:
            self.abort_recipe_processing('金十快讯 API 返回数据为空')

        articles = []
        for item in items:
            data = item.get('data', {})
            if not isinstance(data, dict):
                continue

            content = data.get('content', '') or ''
            if not content:
                continue

            # 部分快讯带【】标题标记，提取出来单独做标题
            title = data.get('title', '').strip()
            if not title:
                title = content[:60].replace('\n', ' ') + (
                    '…' if len(content) > 60 else '')

            # 生成时间
            ts = item.get('time') or data.get('time')
            if ts:
                try:
                    date_str = time.strftime(
                        '%Y-%m-%d %H:%M', time.localtime(int(ts)))
                except (ValueError, OSError):
                    date_str = str(ts)
            else:
                date_str = ''

            articles.append({
                'title': title,
                'url': 'https://www.jin10.com/',
                'date': date_str,
                'description': content,
                'content': f'<p>{content}</p>',
            })

        if not articles:
            self.abort_recipe_processing('未能从金十快讯数据中解析出任何文章')

        return [('金十数据·快讯', articles)]
