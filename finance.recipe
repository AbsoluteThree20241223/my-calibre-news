#!/usr/bin/env python
# vim:fileencoding=utf-8
from calibre.web.feeds.news import BasicNewsRecipe

class FinanceKnowledge(BasicNewsRecipe):
    title = '财经知识'
    description = '每日财经快讯'
    language = 'zh'
    no_stylesheets = True
    remove_javascript = True
    use_embedded_content = True
    max_articles_per_feed = 30
    oldest_article = 7
    timefmt = '[%Y年 %m月 %d日 星期%a]'

    feeds = [
        ('金十数据·快讯', 'https://rsshub.rssforever.com/jin10'),
    ]
